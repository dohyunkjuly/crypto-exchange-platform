# ---- Java / Gradle ----------------------------------------------------------
# All of this is regenerated by `gradle build`, so none of it belongs in git.
.gradle/
build/
backend/.gradle/
backend/build/
backend/**/build/

# The VSCode/Eclipse Java extension compiles into bin/ rather than build/, so the
# rules above miss it entirely. Same deal: regenerated on every save, never committed.
bin/
backend/**/bin/

# ---- Next.js / node ---------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Real secrets and local overrides. web/.env.local.example IS committed (it is the
# template); the .env.local you copy it to is not.
.env
.env*.local

# ---- Python / bots ----------------------------------------------------------
# accounts.json holds the bot accounts' API secrets. `bots` writes it and it is
# the only copy, but it is a local credential and never committed.
bots/config/accounts.json
# One log file per controller. They are appended to forever and never committed.
bots/data/
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# ---- Editors / OS -----------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store

# ---- Logs -------------------------------------------------------------------
*.log
