# The operator's name, shown in the tab title and the header. Nothing in the source names an
# exchange -- this product is white-label.
NEXT_PUBLIC_EXCHANGE_NAME=Crypto Exchange

# Where admin-bff is reachable from the BROWSER, not from inside Docker -- inlined into the
# client bundle at build time. "/" means the page's own origin, which is the case behind the
# edge nginx (deploy/nginx); the compose stack builds with that.
NEXT_PUBLIC_ADMIN_BFF_URL=http://localhost:8083
