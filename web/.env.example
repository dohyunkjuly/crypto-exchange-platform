# The operator's name: tab title, footer, sign-in copy, logo alt text. Nothing in the source
# names an exchange -- this product is white-label. The logos are public/brand/.
NEXT_PUBLIC_EXCHANGE_NAME=Crypto Exchange

# Where web-bff is reachable from the BROWSER, not from inside Docker -- these values are
# inlined into the client bundle at build time. "/" means the page's own origin, which is the
# case behind the edge nginx (deploy/nginx); the compose stack builds with that.
NEXT_PUBLIC_BFF_URL=http://localhost:8081

# Google sign-in. Leave blank to hide the button; web-bff refuses the flow anyway unless
# its own GOOGLE_CLIENT_ID is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
