# Copy to backend/.env and fill in. That file is gitignored; THIS one is committed.
#
#   cp backend/.env.example backend/.env
#   ln -s backend/.env .env      # docker compose interpolates ${...} from the root only
#
# All three apps read it (see `spring.config.import` in each application.yml). Spring
# does NOT pick up .env automatically the way Next.js does -- that import line is what
# wires it in.
#
# The rule: application.yml holds CONFIG (ports, pool sizes, ddl-auto) and is committed.
# This file holds SECRETS and per-machine values, and is not.
#
# In production you ship no .env at all -- your platform (ECS, k8s, Fly) injects these as
# real environment variables, which take precedence over this file.

# ---- MySQL -------------------------------------------------------------------
DATABASE_URL=jdbc:mysql://localhost:3308/exchange?serverTimezone=UTC
DATABASE_USER=exchange
DATABASE_PASSWORD=exchange

# ---- Seed data ----------------------------------------------------------------
# db/seed holds the twelve markets and the fee schedule a developer needs to try the
# system (docs/reference/migrations.md). Set here so `./gradlew bootRun` gets them;
# the compose stack and the tests set the same. Leave it OUT in production: a real
# deployment lists its own markets and publishes its own fees, and the apps refuse to
# start with no fee schedule rather than trade on somebody else's.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# ---- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Copies of every topic the apps create: 1 for the single broker here, 3 on the
# docker-compose.perf.yml overlay and in any deployment (docs/reference/deployment.md).
# Applies when a topic is created; raising it later is a partition reassignment.
KAFKA_REPLICATION_FACTOR=1

# ---- Redis (web-bff's RateLimiter) --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Snapshot storage (spot-matching-engine) ---------------------------------
# Where the engine's periodic order-book snapshots go -- see SnapshotStore. Left
# unset, every one of these silently falls back to the local MinIO in
# docker-compose.yml (see application.yml for the exact defaults), which is exactly
# right for local dev and exactly wrong to forget in production: the engine would
# match orders and save nothing, with no error, until a restart needed a snapshot
# that was never written.
#
# In production, set SNAPSHOT_BUCKET/_REGION for the real bucket and leave
# SNAPSHOT_S3_ENDPOINT and the two credentials below UNSET (or blank) -- blank
# endpoint makes the SDK talk to real AWS S3 instead of MinIO, and blank
# credentials make it use the instance's own IAM role instead of a key sitting in
# a file.
# SNAPSHOT_BUCKET=exchange-spot-snapshots
# SNAPSHOT_REGION=us-east-1
# SNAPSHOT_S3_ENDPOINT=
# SNAPSHOT_S3_ACCESS_KEY=
# SNAPSHOT_S3_SECRET_KEY=

# ---- MongoDB (web-bff reads candles; market-data writes them) ------------------
# 27018 on the host, not 27017 -- see docker-compose.yml.
MONGODB_URI=mongodb://localhost:27018/marketdata

# ---- Email --------------------------------------------------------------------
# `log` writes the verification code to the application log instead of sending it, so
# `./gradlew bootRun` needs no mail server at all. `smtp` sends for real.
#
# Locally, `docker compose up -d mailpit` gives you a real SMTP server on 1025 and a web
# inbox at http://localhost:8025 -- worth using once you care what the email looks like,
# and it exercises the same SmtpMailer that production does.
MAIL_MODE=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
# Mailpit needs no credentials. A provider relay does -- for SendGrid the username is the
# literal string `apikey` and the password is the API key. Turn STARTTLS on with them, or
# that key crosses the network in the clear.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ---- Google sign-in -----------------------------------------------------------
# The OAuth client id from Google Cloud Console. Leave it empty and Google sign-in is
# simply unavailable -- the verifier bean is not created and the endpoint says so.
#
# NOT a secret: it is public by design and appears in the browser. What makes it matter is
# that Google signs ID tokens for every application using it, so the backend compares the
# token's `aud` against this exact value. Wrong or empty, and a token minted by anyone
# else's Google app would sign someone in here.
GOOGLE_CLIENT_ID=

# ---- Auth secrets -------------------------------------------------------------
# 32 raw bytes, base64-encoded (AES-256). Encrypts user_api_keys.secret_encrypted --
# ApiKeyService crashes at startup without it, on purpose, rather than run with a
# placeholder key sitting in git history. Generate one with:
#   openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=

# 32 raw bytes, base64-encoded (AES-256). Encrypts user_mfa_methods.secret_encrypted --
# the TOTP seeds. MfaService crashes at startup without it, same as above.
#
# A SEPARATE key from API_KEY_ENCRYPTION_KEY, deliberately: one key for both would mean
# rotating either forces re-encrypting both, and one leak exposes both.
#   openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# The operator's name, as the authenticator app shows it above a customer's code, and above a
# staff code as "<name> Admin". web-bff and admin-bff refuse to start without it: nothing in
# this repo names an exchange, because the product is white-label and this string lands on
# every phone.
EXCHANGE_NAME=

# ---- The edge (docker compose --profile full) -----------------------------------
# docs/reference/deployment.md. EXCHANGE_DOMAIN adds the production hostnames beside the
# *.localhost ones. ADMIN_ALLOWLIST is the nginx file that decides who may open the staff
# console: unset, the strict one (private networks). On a laptop whose browser reaches Docker
# from a public address (a VPN does this), the local one, which allows everyone.
# EXCHANGE_DOMAIN=
# ADMIN_ALLOWLIST=./deploy/nginx/admin-allowlist.local.conf
